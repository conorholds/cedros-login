# Cedros Login Server Configuration
# Copy this file to .env for local development

# =============================================================================
# Server
# =============================================================================
HOST=0.0.0.0
PORT=57165
AUTH_BASE_PATH=/auth
FRONTEND_URL=http://localhost:57164
# SSO_CALLBACK_URL defaults to FRONTEND_URL + /auth/sso/callback when unset.
SSO_CALLBACK_URL=
BOOTSTRAP_ADMIN_EMAIL=
# Required for POST /setup/admin. Generate with: openssl rand -hex 32
SETUP_TOKEN=
TRUST_PROXY=false

# =============================================================================
# JWT (REQUIRED)
# WARNING: You MUST generate a unique secret for production!
# Generate with: openssl rand -base64 32
# Never use the example value in production - it is publicly known.
# This file is used by docker-compose via .env.
# =============================================================================
JWT_SECRET=generate-a-real-secret-see-instructions-above
JWT_ISSUER=cedros-login
JWT_AUDIENCE=cedros-app
JWT_ACCESS_EXPIRY=900        # 15 minutes (in seconds)
JWT_REFRESH_EXPIRY=604800    # 7 days (in seconds)
TOTP_ENCRYPTION_SECRET=      # Optional; defaults to JWT_SECRET when unset

# =============================================================================
# Database
# Leave unset to use in-memory storage (dev/testing only)
# =============================================================================
DATABASE_URL=postgres://cedros:cedros@localhost:15432/cedros_login
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=2
DATABASE_CONNECT_TIMEOUT=30
DATABASE_IDLE_TIMEOUT=600

# =============================================================================
# Auth Providers
# =============================================================================
# Email/password
EMAIL_ENABLED=true
EMAIL_REQUIRE_VERIFICATION=false  # Defaults to true when ENVIRONMENT=production

# Google OAuth
GOOGLE_ENABLED=true
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Apple Sign In
APPLE_ENABLED=true
APPLE_CLIENT_ID=com.yourcompany.app       # Your Apple Services ID
APPLE_ALLOWED_CLIENT_IDS=
APPLE_TEAM_ID=XXXXXXXXXX                   # Your Apple Developer Team ID
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PEM=

# Solana wallet
SOLANA_ENABLED=true
SOLANA_CHALLENGE_EXPIRY=300  # 5 minutes (in seconds)

# =============================================================================
# Cookie Settings
# =============================================================================
COOKIE_ENABLED=true
COOKIE_DOMAIN=                # Leave empty for same-origin, or set to .yourdomain.com
COOKIE_SECURE=false           # Set to true in production (requires HTTPS)
COOKIE_SAME_SITE=lax          # lax | strict | none
COOKIE_ACCESS_NAME=cedros_access
COOKIE_REFRESH_NAME=cedros_refresh
COOKIE_PATH_PREFIX=/auth

# =============================================================================
# CORS
# Comma-separated list of allowed origins
# =============================================================================
CORS_ORIGINS=http://localhost:57164,http://localhost:3001,http://localhost:5173,http://localhost:57163
CORS_DISABLED=false

# =============================================================================
# Rate Limiting
# Note: Limit values (auth/general/window) are stored in the database
# and managed via the admin UI (GET/PATCH /admin/settings).
# Only the feature flag and backend config are in env vars.
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORE=memory      # memory (default) or redis
# REDIS_URL=redis://localhost:6379  # Required when RATE_LIMIT_STORE=redis

# =============================================================================
# WebAuthn / Passkeys
# =============================================================================
WEBAUTHN_ENABLED=false
WEBAUTHN_RP_ID=yourdomain.com
WEBAUTHN_RP_NAME=Cedros Login
WEBAUTHN_RP_ORIGIN=https://login.yourdomain.com
WEBAUTHN_CHALLENGE_TTL=300
WEBAUTHN_ALLOW_PLATFORM=true
WEBAUTHN_ALLOW_CROSS_PLATFORM=true
WEBAUTHN_REQUIRE_UV=true
WEBAUTHN_REJECT_CLONED=false

# =============================================================================
# Webhook (for standalone mode)
# Generate secret with: openssl rand -base64 32
# =============================================================================
WEBHOOK_ENABLED=false
WEBHOOK_URL=https://your-app.com/api/auth/callback
WEBHOOK_SECRET=generate-a-real-webhook-secret
WEBHOOK_TIMEOUT=10           # Request timeout in seconds
WEBHOOK_RETRIES=2            # Number of retry attempts

# =============================================================================
# Notifications / SSO / Email Providers
# =============================================================================
ENVIRONMENT=development
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SSO_ENABLED=false
POSTMARK_API_TOKEN=
POSTMARK_FROM_EMAIL=
# Configure both Postmark values together. Standalone production-like
# environments always require delivery because invites, password resets,
# deletion confirmations, and security alerts can send independently of
# EMAIL_ENABLED.

# =============================================================================
# Logging
# =============================================================================
RUST_LOG=cedros_login=info,tower_http=info
