{
  "name": "@cedros/login-react",
  "version": "2.0.22",
  "description": "React component library for authentication with email/password, Google OAuth, and Solana wallet sign-in",
  "type": "module",
  "packageManager": "npm@11.13.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./admin": {
      "import": {
        "types": "./dist/admin.d.ts",
        "default": "./dist/admin.js"
      },
      "require": {
        "types": "./dist/admin.d.ts",
        "default": "./dist/admin.cjs"
      }
    },
    "./admin/register": {
      "import": {
        "types": "./dist/admin/register.d.ts",
        "default": "./dist/admin/register.js"
      },
      "require": {
        "types": "./dist/admin/register.d.ts",
        "default": "./dist/admin/register.cjs"
      }
    },
    "./non-wallet": {
      "import": {
        "types": "./dist/non-wallet.d.ts",
        "default": "./dist/non-wallet.js"
      },
      "require": {
        "types": "./dist/non-wallet.d.ts",
        "default": "./dist/non-wallet.cjs"
      }
    },
    "./email-only": {
      "import": {
        "types": "./dist/email-only.d.ts",
        "default": "./dist/email-only.js"
      },
      "require": {
        "types": "./dist/email-only.d.ts",
        "default": "./dist/email-only.cjs"
      }
    },
    "./google-only": {
      "import": {
        "types": "./dist/google-only.d.ts",
        "default": "./dist/google-only.js"
      },
      "require": {
        "types": "./dist/google-only.d.ts",
        "default": "./dist/google-only.cjs"
      }
    },
    "./solana-only": {
      "import": {
        "types": "./dist/solana-only.d.ts",
        "default": "./dist/solana-only.js"
      },
      "require": {
        "types": "./dist/solana-only.d.ts",
        "default": "./dist/solana-only.cjs"
      }
    },
    "./web/register": {
      "import": {
        "types": "./dist/web/register.d.ts",
        "default": "./dist/web/register.js"
      },
      "require": {
        "types": "./dist/web/register.d.ts",
        "default": "./dist/web/register.cjs"
      }
    },
    "./style.css": "./dist/login-react.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --config vite.web.config.ts",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"!src/types/{auth,invite,member,org,profile,session,totp}.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"!src/types/{auth,invite,member,org,profile,session,totp}.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "prepack": "npm run build",
    "smoke:pack": "node ./scripts/smoke-packed-imports.mjs",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node ./scripts/check-i18n-regressions.mjs",
    "check:autosave": "node ../scripts/check-autosave-standard.mjs",
    "audit:autosave": "node ../scripts/audit-autosave-standard.mjs",
    "check:unused": "knip --files --dependencies --reporter compact --no-progress",
    "verify:exports": "node ./scripts/verify-package-exports.mjs",
    "verify:browser-admin": "node --test ./scripts/browser-admin-bundle.test.mjs",
    "verify:browser-web": "node --test ./scripts/browser-web-bundle.test.mjs",
    "prepublishOnly": "npm run lint && npm run check:i18n && npm test && npm run build && npm run verify:exports && npm run verify:browser-web",
    "release": "npm run prepublishOnly && npm publish --access public"
  },
  "peerDependencies": {
    "@solana-mobile/wallet-standard-mobile": "^0.4.4 || ^0.5.0",
    "@solana/wallet-adapter-base": "^0.9.27",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/wallet-adapter-react-ui": "^0.9.39",
    "@solana/wallet-adapter-wallets": "^0.19.37",
    "@solana/web3.js": "^1.98.4",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@solana/wallet-adapter-base": {
      "optional": true
    },
    "@solana/wallet-adapter-react": {
      "optional": true
    },
    "@solana/wallet-adapter-react-ui": {
      "optional": true
    },
    "@solana/wallet-adapter-wallets": {
      "optional": true
    },
    "@solana/web3.js": {
      "optional": true
    },
    "@solana-mobile/wallet-standard-mobile": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@solana-mobile/wallet-standard-mobile": "0.5.3",
    "@solana/wallet-adapter-react-ui": "0.9.39",
    "@solana/web3.js": "1.98.4",
    "@tailwindcss/postcss": "4.1.18",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.3",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/coverage-v8": "4.1.11",
    "autoprefixer": "10.4.22",
    "esbuild": "0.28.1",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "knip": "6.14.2",
    "msw": "2.12.4",
    "postcss": "8.5.25",
    "prettier": "3.7.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.0",
    "vite": "8.0.16",
    "vite-plugin-dts": "4.5.4",
    "vitest": "4.1.11"
  },
  "keywords": [
    "react",
    "authentication",
    "login",
    "google-oauth",
    "solana",
    "wallet",
    "cedros"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": "24.17.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/conorholds/cedros-login.git",
    "directory": "ui"
  },
  "bugs": {
    "url": "https://github.com/conorholds/cedros-login/issues"
  },
  "homepage": "https://github.com/conorholds/cedros-login#readme",
  "dependencies": {
    "motion": "12.42.2",
    "qrcode": "1.5.4"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "overrides": {
    "@humanfs/node": "0.16.8",
    "brace-expansion": "5.0.9",
    "baseline-browser-mapping": "2.11.21",
    "browserslist": "4.28.9",
    "esbuild": "0.28.1",
    "fast-uri": "3.1.6",
    "glob": "13.0.6",
    "jayson": "4.1.1",
    "js-yaml": "4.3.2",
    "metro": "0.84.5",
    "metro-config": "0.84.5",
    "metro-transform-worker": "0.84.5",
    "minimatch": "10.2.4",
    "nanoid": "3.3.18",
    "postcss": "8.5.25",
    "rimraf": "6.1.2",
    "shell-quote": "1.10.0",
    "smol-toml": "1.8.0",
    "uuid": "11.1.1"
  }
}
