{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "eslint.config.js",
    "postcss.config.js",
    "scripts/*.mjs",
    "src/admin/index.ts",
    "src/admin/register.ts",
    "src/email-only.ts",
    "src/extension/capabilities.ts",
    "src/extension/serverRoutes.ts",
    "src/extension/starters.ts",
    "src/google-only.ts",
    "src/index.ts",
    "src/non-wallet.ts",
    "src/solana-only.ts",
    "src/style.ts",
    "src/test/setup.ts",
    "src/web/register.ts",
    "tailwind.config.js",
    "vite.config.ts",
    "vitest.config.ts"
  ],
  "project": [
    "*.config.{js,ts}",
    "postcss.config.js",
    "scripts/*.mjs",
    "src/**/*.{ts,tsx}",
    "tailwind.config.js",
    "!dist/**",
    "!public/mockServiceWorker.js"
  ],
  "ignoreDependencies": ["@solana/wallet-adapter-base", "@solana/wallet-adapter-wallets"],
  "ignoreIssues": {
    "src/admin/register.ts": ["duplicates"],
    "src/admin/teamDirectoryHostService.ts": ["types"],
    "src/admin/types.ts": ["types"],
    "src/autosave/AutosaveConflictDialog.tsx": ["types"],
    "src/autosave/AutosaveRetryBanner.tsx": ["types"],
    "src/autosave/AutosaveStatusIndicator.tsx": ["types"],
    "src/autosave/types.ts": ["types"],
    "src/components/LoginFormBase.tsx": ["types"],
    "src/components/admin/settings/SettingSelect.tsx": ["types"],
    "src/components/email/EmailRegisterForm.tsx": ["types"],
    "src/components/shared/providerIcons.tsx": ["types"],
    "src/context/CedrosLoginContext.ts": ["types"],
    "src/extension/contracts.ts": ["types"],
    "src/extension/jsonSchema.ts": ["types"],
    "src/extension/setupSeeds.ts": ["types"],
    "src/featureFlags.ts": ["types"],
    "src/hooks/useEmailAuth.ts": ["types"],
    "src/i18n/adminTranslations.ts": ["types"],
    "src/i18n/index.ts": ["types"],
    "src/types/adminUser.ts": ["types"],
    "src/types/auth.ts": ["types"],
    "src/types/config.ts": ["types"],
    "src/types/index.ts": ["types"],
    "src/types/systemSettings.ts": ["types"],
    "src/utils/browserWalletAdapter.ts": ["types"],
    "src/utils/crmIdentify.ts": ["types"],
    "src/utils/relyingPartyApi.ts": ["types"]
  },
  "rules": {
    "duplicates": "warn",
    "exports": "warn",
    "types": "warn"
  }
}
