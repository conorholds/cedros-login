{
  "name": "@cedros/login-react-native",
  "version": "2.0.22",
  "description": "React Native authentication library for Cedros with email/password, social login, and crypto wallet support",
  "type": "module",
  "packageManager": "npm@11.13.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./register": {
      "import": {
        "types": "./dist/register.d.ts",
        "default": "./dist/register.js"
      },
      "require": {
        "types": "./dist/register.d.ts",
        "default": "./dist/register.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"!src/types/{auth,invite,member,org,profile,session,totp}.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"!src/types/{auth,invite,member,org,profile,session,totp}.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check:unused": "knip --files --dependencies --reporter compact --no-progress",
    "prepublishOnly": "npm run lint && npm test && npm run build",
    "release": "npm run prepublishOnly && npm publish --access public"
  },
  "peerDependencies": {
    "@invertase/react-native-apple-authentication": "*",
    "@react-native-async-storage/async-storage": "^1.19.0",
    "@react-native-clipboard/clipboard": "^1.0.0",
    "@react-native-google-signin/google-signin": "*",
    "@wallet-ui/react-native-web3js": "*",
    "react": ">=18.0.0",
    "react-native": ">=0.72.0",
    "react-native-biometrics": "*",
    "react-native-keychain": "^10.0.0"
  },
  "peerDependenciesMeta": {
    "@react-native-clipboard/clipboard": {
      "optional": true
    },
    "react-native-keychain": {
      "optional": true
    },
    "@react-native-google-signin/google-signin": {
      "optional": true
    },
    "@invertase/react-native-apple-authentication": {
      "optional": true
    },
    "@wallet-ui/react-native-web3js": {
      "optional": true
    },
    "react-native-biometrics": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@react-native-async-storage/async-storage": "1.24.0",
    "@types/react": "19.2.17",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/coverage-v8": "4.1.11",
    "esbuild": "0.28.1",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "knip": "6.14.2",
    "prettier": "3.8.3",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "test-renderer": "1.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.2",
    "vite": "8.0.16",
    "vite-plugin-dts": "4.5.4",
    "vitest": "4.1.11"
  },
  "keywords": [
    "react-native",
    "authentication",
    "login",
    "oauth",
    "solana",
    "wallet",
    "biometrics",
    "cedros"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": "24.17.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/conorholds/cedros-login.git",
    "directory": "react-native"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "baseline-browser-mapping": "2.11.21",
    "browserslist": "4.28.9",
    "esbuild": "0.28.1",
    "fast-uri": "3.1.6",
    "glob": "13.0.6",
    "js-yaml": "4.3.2",
    "metro": "0.84.5",
    "metro-config": "0.84.5",
    "metro-transform-worker": "0.84.5",
    "minimatch": "10.2.5",
    "nanoid": "3.3.18",
    "postcss": "8.5.25",
    "rimraf": "6.1.2",
    "shell-quote": "1.10.0",
    "smol-toml": "1.8.0",
    "tmp": "0.2.7"
  }
}
