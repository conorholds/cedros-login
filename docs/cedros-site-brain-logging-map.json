{
  "extensionId": "cedros-login",
  "version": "2.0.22",
  "runtimeStatus": {
    "siteBrainEmitter": "wasm-telemetry-live",
    "structuredLogHelper": "wasm-log-and-telemetry-live",
    "existingEvidence": [
      "server-wasm/src/host/telemetry.rs",
      "server-wasm/src/lib.rs",
      "server-wasm/src/host/log.rs",
      "ui/src/admin/register.ts"
    ],
    "notes": "Durable records use telemetry.emit_record with root site-brain-record:* scopes; transient logs use the Wasm log seam and existing audit records."
  },
  "durableRecordPlans": [
    {
      "recordId": "cedros-login:setup-completed-record",
      "category": "setup",
      "subject": "cedros-login:setup-completed",
      "titlePattern": "Cedros Login setup completed",
      "summaryPattern": "Authentication, email, or image storage setup was marked complete by an operator or CRM-owned setup flow.",
      "textPattern": "Use this record to confirm the setup step without storing credentials or direct user identifiers.",
      "tags": [
        "cedros-login",
        "setup"
      ],
      "detailsSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "setupStepId": {
            "type": "string"
          },
          "surfaceId": {
            "type": "string",
            "enum": [
              "cedros-data:crm",
              "cedros-data:settings"
            ]
          },
          "completionSource": {
            "type": "string",
            "enum": [
              "extension-management",
              "crm",
              "host-admin"
            ]
          }
        },
        "required": [
          "setupStepId",
          "surfaceId"
        ]
      },
      "references": [
        {
          "kind": "route",
          "id": "cedros-login:setup-status",
          "label": "Login setup route",
          "description": "Wasm-hosted setup route behind CRM-owned setup surfaces."
        }
      ],
      "recoveryAction": "Open the Cedros Data-owned CRM or settings surface and verify provider/settings state if setup is later reported incomplete."
    },
    {
      "recordId": "cedros-login:provider-unavailable-record",
      "category": "provider",
      "subject": "cedros-login:provider-unavailable",
      "titlePattern": "Login provider unavailable",
      "summaryPattern": "A Login email or image-storage workflow could not run because the site provider was missing, disabled, or unauthorized, or a queued transactional email exhausted its retries.",
      "textPattern": "Provider failures should name the provider access id and feature only. Do not store message bodies, recipient addresses, image object names, credentials, or direct identifiers.",
      "tags": [
        "cedros-login",
        "provider"
      ],
      "detailsSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "providerAccessId": {
            "type": "string",
            "enum": [
              "cedros-login:email-provider",
              "cedros-login:image-storage"
            ]
          },
          "feature": {
            "type": "string"
          },
          "cause": {
            "type": "string",
            "enum": [
              "provider_missing",
              "provider_disabled",
              "permission_denied",
              "provider_error"
            ]
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "required": [
          "providerAccessId",
          "feature",
          "cause"
        ]
      },
      "references": [
        {
          "kind": "provider-call",
          "id": "cedros-login:email-provider",
          "label": "Login transactional email",
          "description": "Site-owned email provider access for Login email workflows."
        }
      ],
      "recoveryAction": "Connect or re-enable the site provider, then retry the affected workflow."
    },
    {
      "recordId": "cedros-login:job-completed-record",
      "category": "job",
      "subject": "cedros-login:job-completed",
      "titlePattern": "Login job completed",
      "summaryPattern": "A Cedros Login automation job completed with redacted counts.",
      "textPattern": "Use aggregate counts and safe run references only. Do not include row payloads, message bodies, or direct identifiers.",
      "tags": [
        "cedros-login",
        "job"
      ],
      "detailsSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "jobId": {
            "type": "string"
          },
          "succeededCount": {
            "type": "integer"
          },
          "skippedCount": {
            "type": "integer"
          },
          "runRef": {
            "type": "string"
          },
          "durationMs": {
            "type": "integer"
          }
        },
        "required": [
          "jobId",
          "succeededCount",
          "skippedCount"
        ]
      },
      "references": [
        {
          "kind": "job",
          "id": "cedros-login:outbox-dispatch",
          "label": "Outbox dispatch",
          "description": "Wasm-hosted Login job executor."
        }
      ],
      "recoveryAction": "No action when counts are expected; inspect the paired failure record when skipped counts are unexpected."
    },
    {
      "recordId": "cedros-login:job-failed-record",
      "category": "job",
      "subject": "cedros-login:job-failed",
      "titlePattern": "Login job failed",
      "summaryPattern": "A Cedros Login automation job failed or exhausted retryable work.",
      "textPattern": "Include only redacted cause codes, aggregate counts, and safe run references.",
      "tags": [
        "cedros-login",
        "job",
        "failure"
      ],
      "detailsSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "jobId": {
            "type": "string"
          },
          "cause": {
            "type": "string",
            "enum": [
              "dependency_missing",
              "provider_unavailable",
              "database_unavailable",
              "downstream_failed",
              "retryable_downstream_failed"
            ]
          },
          "retryable": {
            "type": "boolean"
          },
          "runRef": {
            "type": "string"
          }
        },
        "required": [
          "jobId",
          "cause",
          "retryable"
        ]
      },
      "references": [
        {
          "kind": "job",
          "id": "cedros-login:cleanup-expired-auth-data",
          "label": "Cleanup expired auth data",
          "description": "Wasm-hosted cleanup job executor."
        }
      ],
      "recoveryAction": "Review provider/database binding and retry policy before rerunning the job."
    },
    {
      "recordId": "cedros-login:account-security-record",
      "category": "security",
      "subject": "cedros-login:account-security-event",
      "titlePattern": "Login account security event",
      "summaryPattern": "An account-hardening control changed, such as MFA (TOTP) being disabled on a Login account.",
      "textPattern": "Record only the security event kind. Never store user ids, emails, session ids, secret values, or raw request payloads.",
      "tags": [
        "cedros-login",
        "security"
      ],
      "detailsSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "securityEvent": {
            "type": "string",
            "enum": [
              "mfa-disabled"
            ]
          }
        },
        "required": [
          "securityEvent"
        ]
      },
      "references": [
        {
          "kind": "route",
          "id": "cedros-login:mfa-disable",
          "label": "Login MFA disable route",
          "description": "Wasm-hosted MFA management route that removes a stored TOTP secret."
        }
      ],
      "recoveryAction": "Confirm the account owner intended to disable MFA; review the access audit log for the affected account if unexpected."
    }
  ],
  "transientLogPlans": [
