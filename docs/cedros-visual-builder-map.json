{
  "extensionId": "cedros-login",
  "version": "2.0.22",
  "runtimeTemplateContract": {
    "labelSource": "displayName",
    "zones": [
      {
        "id": "main",
        "label": "Main content",
        "order": 10
      }
    ],
    "provisioningBehavior": "Cedros Data scaffolds authored document zones from template.zones and seeds manifest starter blocks into new page rows."
  },
  "blocks": [
    {
      "type": "cedros-login:auth-page-copy",
      "displayName": "Login Page Copy",
      "category": "identity",
      "order": 10,
      "props": [
        "eyebrow",
        "title",
        "body",
        "primaryLink",
        "secondaryText",
        "variant"
      ],
      "nativeFallback": "Display owner-authored page copy or omit this web-only block."
    },
    {
      "type": "cedros-login:auth-form",
      "displayName": "Login Auth Form",
      "category": "identity",
      "order": 20,
      "props": [
        "mode",
        "title",
        "submitLabel",
        "successMessage",
        "showProviderButtons",
        "enabledProviders",
        "layout"
      ],
      "nativeFallback": "Omit the form or bind a native auth renderer through the host app."
    },
    {
      "type": "cedros-login:login-button",
      "displayName": "Login Button",
      "category": "identity",
      "order": 30,
      "props": [
        "label",
        "href",
        "variant",
        "align"
      ],
      "nativeFallback": "Render a native navigation action if the host binds one."
    },
    {
      "type": "cedros-login:account-workspace",
      "displayName": "Account Workspace",
      "category": "identity",
      "order": 40,
      "props": [
        "title",
        "body",
        "sections",
        "signInHref",
        "signInLabel"
      ],
      "nativeFallback": "Render a native account settings screen if the host binds one."
    }
  ],
  "templates": [
    {
      "id": "cedros-login:login-page-template",
      "displayName": "Login Page Template",
      "contentTypes": [
        "page"
      ],
      "pageSeedId": "cedros-login:login-page",
      "blocks": [
        {
          "type": "cedros-login:auth-form",
          "props": {
            "mode": "sign-in",
            "title": "Log in",
            "submitLabel": "Log in",
            "successMessage": "You will continue after logging in.",
            "showProviderButtons": true,
            "enabledProviders": [
              "email",
              "google",
              "apple",
              "passkey",
              "solana",
              "instant-link"
            ],
            "layout": "card"
          }
        }
      ]
    },
    {
      "id": "cedros-login:register-page-template",
      "displayName": "Register Page Template",
      "contentTypes": [
        "page"
      ],
      "pageSeedId": "cedros-login:register-page",
      "blocks": [
        {
          "type": "cedros-login:auth-page-copy",
          "props": {
            "eyebrow": "Cedros Login",
            "title": "Register",
            "body": "Introduce the registration flow and set expectations before users sign up.",
            "primaryLink": {
              "kind": "cedros-link",
              "href": "/register",
              "label": "Register"
            },
            "secondaryText": "Do not add private invite codes or credentials to this content.",
            "variant": "auth"
          }
        },
        {
          "type": "cedros-login:auth-form",
          "props": {
            "mode": "create-account",
            "title": "Register",
            "submitLabel": "Register",
            "successMessage": "Check your email for the next account step.",
            "showProviderButtons": true,
            "enabledProviders": [
              "email",
              "google",
              "apple",
              "passkey",
              "solana"
            ],
            "layout": "card"
          }
        }
      ]
    },
    {
      "id": "cedros-login:password-recovery-page-template",
      "displayName": "Password Recovery Page Template",
      "contentTypes": [
        "page"
      ],
      "pageSeedId": "cedros-login:password-recovery-page",
      "blocks": [
        {
          "type": "cedros-login:auth-page-copy",
          "props": {
            "eyebrow": "Account recovery",
            "title": "Recover access",
            "body": "Help users find the password recovery flow without exposing account-specific details.",
            "primaryLink": {
              "kind": "cedros-link",
              "href": "/password-recovery",
              "label": "Recover access"
            },
            "secondaryText": "Security-sensitive recovery behavior remains server-bound.",
            "variant": "auth"
          }
        },
        {
          "type": "cedros-login:auth-form",
          "props": {
            "mode": "forgot-password",
            "title": "Forgot password",
            "submitLabel": "Send recovery email",
            "successMessage": "If an account exists, recovery instructions will be sent.",
            "showProviderButtons": false,
            "enabledProviders": [
              "email"
            ],
            "layout": "card"
          }
        }
      ]
    },
    {
      "id": "cedros-login:reset-password-page-template",
      "displayName": "Reset Password Page Template",
      "contentTypes": [
        "page"
      ],
      "pageSeedId": "cedros-login:reset-password-page",
      "blocks": [
        {
          "type": "cedros-login:auth-page-copy",
          "props": {
            "eyebrow": "Account recovery",
            "title": "Reset password",
            "body": "Give users a reviewed page for completing a password reset after a secure handoff.",
            "primaryLink": {
              "kind": "cedros-link",
              "href": "/reset-password",
              "label": "Reset password"
            },
            "secondaryText": "The secure reset check remains server-bound.",
            "variant": "auth"
          }
        },
        {
          "type": "cedros-login:auth-form",
          "props": {
            "mode": "reset-password",
            "title": "Reset password",
            "submitLabel": "Update password",
            "successMessage": "Your password has been updated.",
            "showProviderButtons": false,
            "enabledProviders": [
              "email"
            ],
            "layout": "card"
          }
        }
      ]
    },
    {
      "id": "cedros-login:email-verification-page-template",
      "displayName": "Email Verification Page Template",
      "contentTypes": [
        "page"
      ],
      "pageSeedId": "cedros-login:email-verification-page",
      "blocks": [
        {
          "type": "cedros-login:auth-page-copy",
          "props": {
            "eyebrow": "Email verification",
            "title": "Verify your email",
            "body": "Confirm the email address attached to a new or updated login account.",
            "primaryLink": {
              "kind": "cedros-link",
              "href": "/verify-email",
              "label": "Verify email"
            },
            "secondaryText": "Verification happens through the server before account status changes.",
            "variant": "auth"
          }
        },
        {
          "type": "cedros-login:auth-form",
          "props": {
            "mode": "verify-email",
            "title": "Verify email",
            "submitLabel": "Verify email",
            "successMessage": "Your email is verified.",
            "showProviderButtons": false,
            "enabledProviders": [
              "email"
            ],
            "layout": "card"
          }
        }
      ]
    },
    {
      "id": "cedros-login:instant-link-verification-page-template",
      "displayName": "Instant Link Verification Page Template",
      "contentTypes": [
        "page"
      ],
      "pageSeedId": "cedros-login:instant-link-verification-page",
      "blocks": [
        {
          "type": "cedros-login:auth-page-copy",
          "props": {
            "eyebrow": "Instant link",
            "title": "Continue signing in",
            "body": "Use this reviewed handoff page for users returning from an instant sign-in email.",
            "primaryLink": {
              "kind": "cedros-link",
              "href": "/instant-link/verify",
              "label": "Continue"
            },
            "secondaryText": "The server confirms the sign-in code before creating a session.",
            "variant": "auth"
          }
        },
        {
          "type": "cedros-login:auth-form",
          "props": {
            "mode": "instant-link-verify",
            "title": "Continue with instant link",
            "submitLabel": "Continue",
            "successMessage": "Your sign-in link is confirmed.",
            "showProviderButtons": false,
            "enabledProviders": [
              "email"
            ],
            "layout": "card"
          }
        }
      ]
    },
    {
      "id": "cedros-login:invite-acceptance-page-template",
      "displayName": "Invite Acceptance Page Template",
      "contentTypes": [
        "page"
      ],
      "pageSeedId": "cedros-login:invite-acceptance-page",
      "blocks": [
        {
          "type": "cedros-login:auth-page-copy",
          "props": {
            "eyebrow": "Team invite",
            "title": "Accept your invite",
            "body": "Let invited teammates complete profile details before organization access is activated.",
            "primaryLink": {
              "kind": "cedros-link",
              "href": "/accept-invite",
              "label": "Accept invite"
            },
            "secondaryText": "Invite acceptance is permission-gated and recorded for audit review.",
            "variant": "auth"
          }
        },
        {
          "type": "cedros-login:auth-form",
          "props": {
            "mode": "accept-invite",
            "title": "Accept invite",
            "submitLabel": "Accept invite",
            "successMessage": "Your team access is ready.",
            "showProviderButtons": false,
            "enabledProviders": [
              "email"
            ],
            "layout": "card"
          }
        }
      ]
    },
    {
      "id": "cedros-login:public-profile-page-template",
      "displayName": "Profile Workspace Page Template",
      "contentTypes": [
        "page"
      ],
      "pageSeedId": "cedros-login:public-profile-page",
      "blocks": [
        {
          "type": "cedros-login:account-workspace",
          "props": {
            "title": "Manage your account",
            "body": "Signed-in users can manage profile, security, linked accounts, and sessions here.",
            "sections": [
              "profile",
              "security",
              "linked-accounts",
              "sessions"
            ],
            "signInHref": "/login",
            "signInLabel": "Log in to manage account"
          }
        }
      ]
    }
  ],
  "runtimeBootstrap": {
    "admin": "@cedros/login-react/admin/register",
    "web": "@cedros/login-react/web/register",
    "nativeFallback": "React Native omits these web-only builder templates unless a native renderer is host-bound."
  }
}
