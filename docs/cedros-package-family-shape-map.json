{
  "extensionId": "cedros-login",
  "manifestVersion": "2.0.22",
  "packageMembers": [
    {
      "packageRef": "server",
      "localPath": "server",
      "manifestPackageName": "cedros-login",
      "manifestVersion": "2.0.22",
      "metadataFile": "server/Cargo.toml",
      "metadataPackageName": "cedros-login",
      "metadataVersion": "2.0.22",
      "registrationEntrypoint": "cedros_login::register_extension_family",
      "buildCommand": "cargo test --manifest-path server/Cargo.toml extension_manifest --all-features",
      "status": "wasm-package-ready"
    },
    {
      "packageRef": "react",
      "localPath": "ui",
      "manifestPackageName": "@cedros/login-react",
      "manifestVersion": "2.0.22",
      "metadataFile": "ui/package.json",
      "metadataPackageName": "@cedros/login-react",
      "metadataVersion": "2.0.22",
      "registrationEntrypoint": "@cedros/login-react/admin/register and @cedros/login-react/web/register",
      "buildCommand": "cd ui && npm run build",
      "status": "package-ready after JS dependency and SDK verification"
    },
    {
      "packageRef": "reactNative",
      "localPath": "react-native",
      "manifestPackageName": "@cedros/login-react-native",
      "manifestVersion": "2.0.22",
      "metadataFile": "react-native/package.json",
      "metadataPackageName": "@cedros/login-react-native",
      "metadataVersion": "2.0.22",
      "registrationEntrypoint": "@cedros/login-react-native/register",
      "buildCommand": "cd react-native && npm run build",
      "status": "package-ready after JS dependency, SDK, and native loader verification"
    }
  ],
  "versionAlignment": {
    "policy": "The root manifest, every packageFamily member, and package metadata use the same exact version.",
    "documentedRootVersionMismatches": []
  },
  "requiredExports": [
    "server:cedros_login::register_extension_family",
    "react:./admin/register",
    "react:./web/register",
    "reactNative:./register"
  ],
  "blockedRuntimeGaps": [
    "Cedros platform capability/WIT admission and live database transaction evidence remain host-coordinated.",
    "React Native host loader remains host-coordinated.",
    "Supply-chain provenance/SBOM/signature evidence is not provided for marketplace trust verification."
  ]
}
