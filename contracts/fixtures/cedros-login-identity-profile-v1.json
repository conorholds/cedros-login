        "sourceState": {
          "emailLinked": true,
          "emailVerified": true,
          "passwordConfigured": true,
          "solanaWalletLinked": true,
          "evmWalletLinked": false
        },
        "updatedAt": "2026-08-18T12:00:00Z"
      }
    },
    "sessions": {
      "currentUser": {
        "environmentVariable": "CEDROS_LOGIN_CURRENT_USER_TOKEN",
        "subjectId": "login-subject-complete",
