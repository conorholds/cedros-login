  "installedHostCases": [
    {
      "id": "current-user",
      "routeId": "cedros-login:identity-profile-current",
      "authentication": "valid-current-user-session-for-login-subject-complete",
      "request": { "method": "GET", "path": "/v1/identity/profile" },
      "expectedStatus": 200,
      "expectedProjection": "complete",
      "expectedCacheControl": "private, no-store"
    },
    {
      "id": "administrator",
      "routeId": "cedros-login:identity-profile-admin-get",
      "authentication": "cedros-casino-service-token-with-identity-profile-read-and-org-casino",
      "request": {
        "method": "GET",
        "path": "/v1/identity/users/login-subject-complete/profile",
        "query": { "orgId": "org-casino" }
      },
      "expectedStatus": 200,
      "expectedProjection": "complete",
      "expectedAuditEvent": "admin.identity_profile_read",
      "expectedCacheControl": "private, no-store"
    },
    {
      "id": "expired-session",
      "routeId": "cedros-login:identity-profile-current",
      "authentication": "expired-or-revoked-current-user-session",
      "request": { "method": "GET", "path": "/v1/identity/profile" },
      "expectedStatus": 401,
      "expectedError": "invalid_session",
      "expectedCacheControl": "private, no-store"
    },
    {
      "id": "denial",
      "routeId": "cedros-login:identity-profile-admin-get",
      "authentication": "cedros-portal-service-token-without-identity-profile-read",
      "request": {
        "method": "GET",
        "path": "/v1/identity/users/login-subject-complete/profile",
        "query": { "orgId": "org-casino" }
      },
      "expectedStatus": 403,
      "expectedError": "insufficient_scope",
      "expectedAuditEvents": 0,
      "expectedCacheControl": "private, no-store"
    },
    {
      "id": "cross-tenant",
      "routeId": "cedros-login:identity-profile-admin-get",
      "authentication": "cedros-casino-service-token-with-identity-profile-read-and-org-casino",
      "request": {
        "method": "GET",
        "path": "/v1/identity/users/login-subject-other-tenant/profile",
        "query": { "orgId": "org-casino" }
      },
      "expectedStatus": 404,
      "expectedError": "subject_not_found",
      "expectedAuditEvents": 0,
      "expectedCacheControl": "private, no-store"
    }
  ]
}
