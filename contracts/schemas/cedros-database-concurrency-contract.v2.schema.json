{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cedros.dev/contracts/database-concurrency/v2/schema.json",
  "title": "Cedros database concurrency contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractId",
    "capability",
    "compatibility",
    "supersedes",
    "operationSchemaCatalogs",
    "conflictTransport",
    "uniqueConstraints",
    "conditionalMutations",
    "lifecycleWriteGuards",
    "acceptanceFixture"
  ],
  "properties": {
    "$schema": { "const": "../schemas/cedros-database-concurrency-contract.v2.schema.json" },
    "schemaVersion": { "const": 2 },
    "contractId": { "const": "cedros-data:database-concurrency-v2" },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "requiredForProduction",
        "detectionPhase",
        "missingBehavior"
      ],
      "properties": {
        "id": { "const": "cedros-data:database-concurrency-v2" },
        "requiredForProduction": { "const": true },
        "detectionPhase": { "const": "install-or-readiness" },
        "missingBehavior": { "const": "block-install-and-activation" }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currentWitPackage",
        "currentGuestBehavior",
        "hostUpgradeBehavior"
      ],
      "properties": {
        "currentWitPackage": { "const": "cedros:extension@0.1.0" },
        "currentGuestBehavior": { "const": "conditional-batch-v2" },
        "hostUpgradeBehavior": { "const": "enforce-before-advertise" }
      }
    },
    "supersedes": {
      "type": "object", "additionalProperties": false,
      "required": ["contractId", "immutableOperationIds"],
      "properties": {
        "contractId": { "const": "cedros-data:database-concurrency-v1" },
        "immutableOperationIds": {
          "type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "operationSchemaCatalogs": {
      "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^contracts/host/operations/v2/.+\\.json$" }
    },
    "conflictTransport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legacyMessageFormat",
        "categories",
        "httpStatus",
        "clientCode",
        "piiAllowed"
      ],
      "properties": {
        "legacyMessageFormat": {
          "const": "cedros.db.v1|<unique|precondition|lease>|<operation-id>"
        },
        "categories": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["unique", "precondition", "lease"] }
        },
        "httpStatus": { "const": 409 },
        "clientCode": { "const": "resource_conflict" },
        "piiAllowed": { "const": false }
      }
    },
    "uniqueConstraints": {
      "type": "array",
      "minItems": 10,
      "items": { "$ref": "#/$defs/uniqueConstraint" }
    },
    "conditionalMutations": {
      "type": "array",
      "minItems": 22,
      "items": { "$ref": "#/$defs/conditionalMutation" }
    },
    "acceptanceFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "requiredScenarioIds",
        "minimumConcurrentAttempts",
        "minimumIndependentWorkers",
        "requiredOutboxRecoveryCases",
        "requiredCompositeCases"
      ],
      "properties": {
        "path": {
          "const": "contracts/fixtures/cedros-database-concurrency-v2.json"
        },
        "requiredScenarioIds": {
          "type": "array",
          "minItems": 22,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "minimumConcurrentAttempts": { "const": 50 },
        "minimumIndependentWorkers": { "const": 2 },
        "requiredOutboxRecoveryCases": {
          "type": "array",
          "const": [
            "expired-sending-lease",
            "completed-response-lost-replay",
            "stale-worker-cannot-complete-successor-lease",
            "token-email-response-lost-replay"
          ]
        },
        "requiredCompositeCases": {
          "type": "array",
          "minItems": 24,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
    ,
    "lifecycleWriteGuards": {
      "type": "object", "additionalProperties": false,
      "required": [
        "storage", "identityRoot", "identityChildren", "organizationRoot",
        "organizationChildren", "rules"
      ],
      "properties": {
        "storage": { "const": "host-owned-durable-tombstones" },
        "identityRoot": { "$ref": "#/$defs/lifecycleRoot" },
        "organizationRoot": { "$ref": "#/$defs/lifecycleRoot" },
        "identityChildren": { "$ref": "#/$defs/modelList" },
        "organizationChildren": { "$ref": "#/$defs/modelList" },
        "rules": {
          "type": "array", "minItems": 6,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "lifecycleRoot": {
      "type": "object", "additionalProperties": false,
      "required": ["contentModelId", "entryKeyField"],
      "properties": {
        "contentModelId": { "type": "string", "pattern": "^cedros-login:" },
        "entryKeyField": { "const": "entryKey" }
      }
    },
    "modelList": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^cedros-login:" }
    },
    "uniqueConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "accessId",
        "contentModelId",
        "fields",
        "normalization",
        "predicate",
        "conflictCategory"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]+$" },
        "accessId": { "type": "string", "pattern": "^cedros-login:" },
        "contentModelId": { "type": "string", "pattern": "^cedros-login:" },
        "fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "normalization": { "enum": ["none", "lowercase", "trim-lowercase"] },
        "predicate": { "type": ["string", "null"] },
        "conflictCategory": { "const": "unique" }
      }
    },
    "conditionalMutation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "accessId",
        "contentModelIds",
        "atomicity",
        "preconditions",
        "mutations",
        "conflictCategory"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]+$" },
        "accessId": { "type": "string", "pattern": "^cedros-login:" },
        "contentModelIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^cedros-login:" }
        },
        "atomicity": {
          "description": "Required observable isolation. single-host-serializable-transaction permits literal SERIALIZABLE or a phantom-safe equivalent proven by live execution of the acceptance fixture.",
          "enum": ["single-host-transaction", "single-host-serializable-transaction"]
        },
        "requiredCapabilityId": {
          "enum": [
            "cedros-data:token-email-evidence-v1",
            "cedros-data:identity-atomic-v1",
            "cedros-data:signup-limit-atomic-v1"
          ]
        },
        "preconditions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "mutations": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "conflictCategory": { "enum": ["precondition", "lease"] }
      }
    }
  }
}
