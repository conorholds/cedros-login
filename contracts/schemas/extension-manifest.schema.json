{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cedros.dev/login/extension-manifest.schema.json",
  "title": "Cedros Login Extension Manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "extensionId",
    "displayName",
    "version",
    "packageFamily",
    "surfaces",
    "registration"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "extensionId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "displayName": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+" },
    "platformApiVersion": { "type": "string", "minLength": 1 },
    "packageFamily": { "type": "object" },
    "surfaces": { "type": "object" },
    "registration": { "type": "object" },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "displayName", "category", "requestedScopes"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9-]*$" },
          "displayName": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "requestedScopes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["verb", "resource", "summary"],
              "properties": {
                "verb": {
                  "enum": ["read", "write", "trigger", "send", "call", "expose"]
                },
                "resource": { "type": "string", "minLength": 1 },
                "summary": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "adminModules": { "type": "array" },
    "analytics": { "type": "object" },
    "providerAccess": { "type": "array" },
    "crmSourceAccess": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "sourceKind",
          "displayName",
          "description",
          "scopes",
          "eventTypes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9-]*$"
          },
          "sourceKind": { "type": "string", "minLength": 1 },
          "displayName": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "scopes": {
            "type": "array",
            "minItems": 1,
            "items": { "const": "write" }
          },
          "eventTypes": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "databaseAccess": { "type": "array" },
    "setupSeeds": { "type": "object" },
    "pageSeeds": { "type": "array" },
    "contentBlocks": { "type": "array" },
    "contentTemplates": { "type": "array" },
    "formTemplates": { "type": "array" },
    "docsArticles": { "type": "array" },
    "onboardingPages": { "type": "array" }
  }
}
