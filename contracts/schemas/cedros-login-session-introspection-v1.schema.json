{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cedros.ai/contracts/cedros-login/session-introspection-v1.schema.json",
  "title": "cedros-login:session-introspection:v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["active"],
      "properties": {
        "active": { "const": false }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["active", "userId", "sessionId", "expiresAt", "claims"],
      "properties": {
        "active": { "const": true },
        "userId": { "type": "string", "minLength": 1 },
        "sessionId": { "type": "string", "minLength": 1 },
        "expiresAt": { "type": "string", "format": "date-time" },
        "claims": {
          "type": "object",
          "additionalProperties": false,
          "required": ["iss", "sub", "aud", "exp", "iat", "sid"],
          "properties": {
            "iss": { "type": "string", "minLength": 1 },
            "sub": { "type": "string", "minLength": 1 },
            "aud": { "type": "string", "minLength": 1 },
            "exp": { "type": "integer" },
            "iat": { "type": "integer" },
            "sid": { "type": "string", "minLength": 1 },
            "emailVerified": { "type": "boolean" }
          }
        }
      }
    }
  ]
}
